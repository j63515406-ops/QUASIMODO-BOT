# ===== BingX =====
BINGX_API_KEY=
BINGX_API_SECRET=
# Real: https://open-api.bingx.com   |  Demo (VST): https://open-api-vst.bingx.com
BINGX_BASE_URL=https://open-api.bingx.com
HEDGE_MODE=true

# ===== Telegram =====
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ===== Modo =====
# true = solo avisa por Telegram (NO opera). Pon false para operar de verdad.
DRY_RUN=true

# ===== Escaneo =====
TIMEFRAME=15m
CANDLES=500
MIN_QUOTE_VOLUME=2000000
EXCLUDE_PREFIX=NCCO,NCSK,NCFX,NCSI
WHITELIST=
BLACKLIST=
WORKERS=8
RATE_PER_SEC=8
CLOSE_DELAY_SECS=6
SIDE_FILTER=BOTH
NOTIFY_SETUPS=false

# ===== Riesgo / ejecucion =====
RISK_PCT=1.0
LEVERAGE=5
MAX_OPEN=3
TP1_PCT=50
MOVE_BE=true
MONITOR_SECS=20
MAX_SLIPPAGE_R=0.35

# ===== Estrategia (igual que el Pine) =====
PIV_LEN=5
MIN_SWEEP=0.15
MIN_LEG=1.5
ZONE_ATR=0.35
MAX_WAIT=80
MAX_RUN=150
SIG_MODE=confirm
CONF_WIN=5
SL_BUF=0.1
MIN_SCORE=3
ST_LEN=10
ST_FAC=3.0
RSI_LEN=14
RSI_HI=70
RSI_LO=30
CVD_LEN=3
VOL_MULT=1.2
USE_HTF=false
HTF_TIMEFRAME=4h
HTF_LEN=50
STATE_FILE=state.json
