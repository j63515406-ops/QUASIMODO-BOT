# ===== BingX =====
BINGX_API_KEY=
BINGX_API_SECRET=
# Real: https://open-api.bingx.com   |  Demo (VST): https://open-api-vst.bingx.com
BINGX_BASE_URL=https://open-api.bingx.com
HEDGE_MODE=true

# ===== Telegram =====
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ===== Modo =====
# true = solo avisa por Telegram (NO opera). Pon false para operar de verdad.
DRY_RUN=true

# ===== Escaneo =====
# Varias temporalidades a la vez, separadas por coma (un escaner independiente por cada una).
# Si no defines TIMEFRAMES pero sí TIMEFRAME (antiguo), se usa TIMEFRAME.
TIMEFRAMES=1h,4h
CANDLES=500
MIN_QUOTE_VOLUME=2000000
EXCLUDE_PREFIX=NCCO,NCSK,NCFX,NCSI
WHITELIST=
BLACKLIST=
WORKERS=8
RATE_PER_SEC=8
CLOSE_DELAY_SECS=6
SIDE_FILTER=BOTH
SCAN_ON_START=true

# ===== Avisos =====
# Avisos del patrón: bos | tap | bos,tap | all | (vacío = apagado). Ojo: "all" puede ser mucho ruido.
NOTIFY_SETUPS=
# Avisa T1 / T2 / cabeza rota de las señales ya enviadas (solo en DRY_RUN; en real avisa el monitor)
NOTIFY_OUTCOMES=true
# Radar cada N minutos por temporalidad (monedas esperando QML + más cercanas). 0 = apagado
RADAR_EVERY_MIN=60
RADAR_TOP=5
# Velas hacia atrás que se revisan en cada ciclo (recupera señales si un ciclo falló)
SIGNAL_LOOKBACK=2
MAX_SIGNALS_PER_CYCLE=10

# ===== Costes =====
FEE_PCT=0.05
SLIP_PCT=0.03
# Descarta señales cuyo coste ida y vuelta (fees+slippage) supere este valor en R
MAX_COST_R=0.35

# ===== Riesgo / ejecucion =====
RISK_PCT=1.0
LEVERAGE=5
MAX_OPEN=3
TP1_PCT=50
MOVE_BE=true
MONITOR_SECS=20
MAX_SLIPPAGE_R=0.35
# Score mínimo (de 5) para OPERAR; por debajo solo avisa (MIN_SCORE es el umbral para avisar)
TRADE_MIN_SCORE=3

# ===== Estrategia (defaults = Pine LunqFX) =====
PIV_LEN=5
MIN_SWEEP=0.10
MIN_LEG=0
ZONE_ATR=0.25
MAX_WAIT=60
MAX_RUN=120
SIG_MODE=confirm
CONF_WIN=5
SL_BUF=0.1
MIN_SCORE=2
MIN_RR=1.0
ST_LEN=10
ST_FAC=3.0
RSI_LEN=14
RSI_HI=70
RSI_LO=30
CVD_LEN=3
VOL_MULT=1.2
USE_HTF=false
HTF_TIMEFRAME=4h
HTF_LEN=50
STATE_FILE=state.json
